# macOS
.DS_Store
._*

# Editor scratch
*.swp
*.swo

# Machine-local config — job-specific paths, secrets, per-machine overrides.
# See README.md.
#
# These files live in $HOME rather than in this repo, so none of them can be
# committed by accident today. The patterns are here so that stays true if one
# is ever moved or copied in — .npmrc especially, which is the conventional
# place for a registry token.
*.local
.zshrc.local
.gitconfig.work
.npmrc
.env
.env.*

# Claude Code — ALLOW-LIST, not a deny-list. ~/.claude holds transcripts, typed
# history, per-project memory, caches and machine-local settings: employer work
# product and personal notes. This repo is public, so everything under claude/ is
# ignored by default and only the portable config is re-admitted below. A
# deny-list cannot anticipate new files (a settings.json.bak-* slipped through one).
claude/*
!claude/CLAUDE.md
!claude/README.md
!claude/settings.json
!claude/link.sh
!claude/hooks/
!claude/skills/
!claude/agents/

# ...and re-exclude anything that must never ship even inside those dirs.
claude/**/*.bak*
claude/**/*.local.json
claude/hooks/peon-ping/
claude/**/.credentials*
