[i18n]
	filesEncoding = utf-8
[core]
	editor = vim
	autocrlf = False
[merge]
	tool = kdiff3
[diff]
	guitool = araxis
[mergetool "kdiff3"]
	path = /Applications/kdiff3.app/Contents/MacOS/kdiff3
[push]
	default = simple
	autoSetupRemote = true
[user]
	email = john@magnusson.gl
	name = JoMa
[pull]
	rebase = false
[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential
