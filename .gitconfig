[i18n]
	filesEncoding = utf-8
[core]
	editor = vim
	autocrlf = False
[push]
	default = simple
	autoSetupRemote = true
[user]
	email = john@magnusson.gl
	name = JoMa
# Short-lived branches reconcile by replaying onto the new base, which is what
# the stale-base reminder tells you to do anyway — a merge commit per pull just
# records that origin moved.
[pull]
	rebase = true

# `main` for anything started here. Repos that still use `master` set it in the
# machine-local config for that directory, so the default isn't fought per repo.
[init]
	defaultBranch = main
# Stale `origin/*` refs are a lie about what still exists: a merged branch is
# deleted on the server, but the tracking ref lingers here until pruned, so
# `git branch -a` keeps advertising work that already landed. Prunes on fetch.
# This never deletes a local branch — `git branch -d` stays a deliberate act.
[fetch]
	prune = true
	pruneTags = true
	all = true
[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential
# Machine-local git config — a per-job identity, work-only credential helpers,
# anything that should not be in a public repo. Not committed; see README.
#
# Last, so it wins: git resolves a repeated key to the last value it reads, so
# an [user] block in the included file overrides the one above. A missing file
# is not an error, so this is safe on a machine that has no local config.
[include]
	path = ~/.gitconfig.local

# Reading history. Branches are a work queue here, not an archive — they live
# half a day — so the freshest one belongs at the top of the list.
[branch]
	sort = -committerdate
[tag]
	sort = version:refname

# Diffs that describe the change rather than the text. histogram tracks moved
# code better than the default myers; colorMoved says which hunks moved rather
# than were rewritten; mnemonicPrefix labels sides i/w/c instead of a/b.
[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true

# zdiff3 keeps the common lines outside the conflict markers, so a conflict
# shows what actually diverged. Never used to text-merge a SOPS file.
[merge]
	conflictStyle = zdiff3

# Rebase without the manual bookkeeping: fixup!/squash! commits reorder
# themselves, a dirty tree stashes and comes back, and updateRefs carries the
# other branches in a stack along with it.
[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true

# Resolve a given conflict once and git replays that resolution next time it
# sees it — earns its keep when the same rebase gets redone.
[rerere]
	enabled = true
	autoupdate = true

# Offer the correction, don't silently run it — autocorrect that guesses and
# executes is how you fire a command you didn't type.
[help]
	autocorrect = prompt

# Diff in the commit editor. A no-op for `commit -m`, useful by hand.
[commit]
	verbose = true
